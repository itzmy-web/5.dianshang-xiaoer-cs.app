# 电商小二（智能客服）配置模板 —— A8：复制为 .env 并填入真实凭据
# LLM（SiliconFlow OpenAI 兼容网关）
LLM_MODEL=Qwen/Qwen3-32B
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=your_siliconflow_api_key

# 商城 API：单服务版由本应用内置提供（mock_commerce_router，无前缀），填本服务自身地址
COMMERCE_API_BASE_URL=http://127.0.0.1:18082

# 数据库（本地通用 SQLite 单文件存储，无需 MySQL）
DATABASE_URL=sqlite:///customer_service.db

APP_HOST=0.0.0.0
APP_PORT=9000

# 数字人（魔珐星云）——凭证只放服务端，前端经 /api/digital-human/credentials 获取
DIGITAL_HUMAN_APP_ID=
DIGITAL_HUMAN_APP_SECRET=

# 管理后台密码（A8：已删除代码内弱默认 admin888，缺失即启动失败）
ADMIN_PASSWORD=replace_with_strong_password
